# https://github.com/deepgram-starters/nextjs-live-transcription
# Copy to .env.local (git-ignored) for `next dev`. Without a Cloudflare context
# `next dev` has no Workers AI binding (and no /api/listen socket, which the
# Worker's entry answers), so the page transcribes only with a Deepgram key set
# here (README → Use your own Deepgram key; Member scope or higher). On stage and
# prod the key is the product's optional Orun secret, which the deploy pushes to
# the Worker as a secret; the token route reads it per request and no build ever
# sees it.
DEEPGRAM_API_KEY=
# The site's public origin (metadataBase, the share links). The deploy sets it
# per environment; unset, it is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
